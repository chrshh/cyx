*.o
*.a
run_*
bin/

# macOS
.DS_Store
*.dSYM/

# Python bytecode caches (from the build.py / build-rust.py helpers)
__pycache__/
*.pyc

# cjsh
userland/cjsh/cjsh
userland/cjsh/tests/test_lexer
userland/cjsh/tests/test_parser
userland/cjsh/tests/test_ast

# userland app binaries (built in-place by each app's Makefile).
# Add new app binaries here as you create them, or build into a bin/ subdir
# (already covered by the top-level `bin/` rule).
userland/apps/asemics/asemics
# zonule (the Smithay compositor) is built in docker; ignore its cargo target/.
userland/display/zonule/target/

# build artifacts
build/
initramfs/init
initramfs/initramfs.cpio.gz
initramfs/rootfs/init
initramfs/rootfs/bin/
initramfs/rootfs/dev/
initramfs/rootfs/proc/
initramfs/rootfs/sys/
initramfs/rootfs/tmp/
initramfs/rootfs/root/

# disk/rootfs is fully assembled at build time from the Debian docker export
# + our custom binaries. Nothing in here is hand-edited source.
disk/rootfs/
disk/init

# Raspberry Pi 4 VideoCore firmware blobs — downloaded by
# disk/rpi-boot/fetch-firmware.sh, not source we track.
disk/rpi-boot/start4.elf
disk/rpi-boot/fixup4.dat

# kernel: upstream Linux source is huge and reproducible from kernel.org.
# Keep only the .config (our custom build) and the README.
kernel/src/*
!kernel/src/.config
