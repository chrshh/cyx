# cjyx kernel config fragment — Raspberry Pi 4 (BCM2711) + QEMU `-M virt`.
#
# One multiplatform arm64 Image boots BOTH the real Pi 4 and the QEMU dev VM,
# so this enables both the BCM2711 SoC drivers and the virtio drivers.
#
# Applied on top of the stock arm64 defconfig (see the top-level Makefile's
# kernel-config target):
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m .config kernel/cjyx_rpi4.config
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
#
# This OS runs NO kernel modules — CONFIG_MODULES=n. Because that turns every
# =m driver in the stock defconfig off, we must re-assert each needed driver as
# =y below.

# --- no modules; trim debug/trace/power bloat (boot time + image size) ---
# CONFIG_MODULES is not set
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_PROFILING is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_MD is not set
# CONFIG_NUMA is not set
# CONFIG_BLK_DEV_INITRD is not set

# --- Raspberry Pi 4 SoC platform (BCM2711) ---
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_PINCTRL_BCM2835=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_BCM2835_MBOX=y
CONFIG_BCM2835_WDT=y

# --- storage / boot (SD card + FAT boot partition names) ---
CONFIG_MMC=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- USB3 (VL805 xHCI behind the BRCMSTB PCIe controller) ---
CONFIG_PCI=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_DWC2=y
CONFIG_USB_STORAGE=y

# --- Gigabit Ethernet (Wi-Fi/BT deferred: add brcmfmac/btbcm when needed) ---
CONFIG_NETDEVICES=y
CONFIG_BCMGENET=y

# --- GPU: VideoCore VI. Built in so a DRM/KMS device exists; we render via
#     llvmpipe (software) for bring-up, so v3d is optional but cheap to keep. ---
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y

# --- input + serial console (PL011 UART on the GPIO header) ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_I2C_BCM2835=y
CONFIG_SPI_BCM2835=y

# --- QEMU `-M virt` dev path: one Image boots both. virtio for disk, input,
#     gpu, and console; the generic PCI host bridge that virt exposes. ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_PCI_HOST_GENERIC=y

# --- filesystems / core the guest rootfs + tmpfs mounts need ---
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX=y
CONFIG_INOTIFY_USER=y
