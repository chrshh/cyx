# Toolchain image for building the cmd-rs workspace (Rust coreutil-style
# commands). Uses rust:1-bookworm so each binary links against Debian
# bookworm's glibc (2.36) — the same glibc baked into our guest's Debian
# userland. Building on the Arch host would link against glibc 2.43 and
# fail to run inside the guest. Commands here are expected to be pure Rust
# (no -sys crates), so no apt-installed dev headers are required.
FROM rust:1-bookworm

WORKDIR /work
