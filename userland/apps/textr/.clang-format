---
Language: Cpp
BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4

# Line width
ColumnLimit: 100

# Braces — K&R style: same line for functions and control flow
BreakBeforeBraces: Attach
Cpp11BracedListStyle: false

# Allow single-line forms (this is the key one for your if/else if complaint)
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortBlocksOnASingleLine: Always
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Empty
AllowShortLoopsOnASingleLine: false

# Alignment — this is what gives the "column-aligned" look
AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignConsecutiveDeclarations:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignConsecutiveMacros:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
AlignTrailingComments: true
AlignAfterOpenBracket: Align
AlignOperands: Align

# Pointers stick to the type: `int *p` not `int* p` or `int *p`
PointerAlignment: Right

# Spaces
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpaceAfterCStyleCast: false

# Includes — keep your own grouping, don't reorder
SortIncludes: Never

# Misc
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
ReflowComments: true
IncludeBlocks: Preserve
